<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pestanas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/azul"
        app:tabIndicatorColor="@color/naranja"
        app:tabSelectedTextColor="@color/naranja"
        app:tabTextColor="@color/claro_tenue" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/vacioTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No hay ningún envío armado para hoy."
                    android:textColor="@color/claro"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbrirDia"
                    style="@style/Boton.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/abrir_dia" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lineaEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/claro_tenue"
                    android:textSize="13sp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tarjetaMedio"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:cardBackgroundColor="@color/azul_tarjeta"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/azul_borde"
                        app:layout_constraintDimensionRatio="4:5"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.78">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/medio"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Flyer o clip"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/iconoClip"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_gravity="center"
                                android:contentDescription="Clip"
                                android:src="@drawable/ic_play"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/sinMedio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:padding="16dp"
                                android:textColor="@color/claro_tenue"
                                android:visibility="gone" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/aviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_etiqueta"
                    android:padding="12dp"
                    android:textColor="@color/naranja"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="14dp"
                    android:textColor="@color/claro"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/destino"
                    app:helperText="Tocá para abrir el destino.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/claro" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/bandaEnviado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textoEnviado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Marcado como enviado."
                        android:textColor="@color/claro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeshacer"
                        style="@style/Boton.Texto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/deshacer" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviar"
        style="@style/Boton.Principal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/enviar" />
</LinearLayout>
